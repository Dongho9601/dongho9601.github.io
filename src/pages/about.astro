---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  bioSummary,
  experiences,
  educations,
  industryProjects,
  serviceCommittees,
  journalReviews,
  fundings,
  languages,
  collaborators,
  ongoingTopics,
} from '../data/about';
import { siteConfig } from '../data/site';
---

<BaseLayout
  title="About — Dongho Ha"
  description="Biography, professional experience, education, and research background of Dongho Ha."
>
  <header class="page-header">
    <h1 class="page-title">About</h1>
    <p class="page-lead">
      Dongho (Lucas) Ha · Computer Architect
    </p>
  </header>

  <!-- 1. Profile & Biography Section -->
  <section class="about-profile-grid">
    <div class="about-bio-col">
      <h2 style="margin-top: 0; font-size: 1.25rem; margin-bottom: 0.85rem;">Biography</h2>
      <div class="prose" style="font-size: 0.96rem;">
        {bioSummary.split('\n\n').map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </div>

    <div class="about-avatar-col">
      <img
        src="/images/profile.jpg"
        alt="Dongho Ha"
        class="about-avatar-img"
      />
      <div class="about-cv-links">
        <a
          href={siteConfig.resumeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="about-cv-link"
        >
          View CV ↗
        </a>
      </div>
    </div>
  </section>

  <!-- 2. Professional Experience -->
  <section class="section-container">
    <div class="section-header">
      <h2 class="section-title">Professional Experience</h2>
    </div>

    <div class="timeline-list">
      {
        experiences.map((exp) => (
          <div class="timeline-item">
            <div class="timeline-header">
              <div class="timeline-role">
                {exp.role}
                <span style="font-weight: 400; color: var(--text-muted);"> — </span>
                {exp.link ? (
                  <a
                    href={exp.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="plain-link"
                    style="font-weight: 500;"
                  >
                    {exp.company} ↗
                  </a>
                ) : (
                  <span>{exp.company}</span>
                )}
                {exp.team && (
                  <span style="font-size: 0.88rem; color: var(--text-faint); font-weight: 400;">
                    {' '}({exp.team})
                  </span>
                )}
              </div>
              <span class="timeline-period">{exp.period}</span>
            </div>
            {exp.details && (
              <div class="timeline-details">{exp.details}</div>
            )}
          </div>
        ))
      }
    </div>
  </section>

  <!-- 3. Education -->
  <section class="section-container">
    <div class="section-header">
      <h2 class="section-title">Education</h2>
    </div>

    <div class="timeline-list">
      {
        educations.map((edu) => (
          <div class="timeline-item">
            <div class="timeline-header">
              <div class="timeline-role">{edu.degree}</div>
              <span class="timeline-period">{edu.period}</span>
            </div>
            <div class="timeline-org">
              {edu.institution}
              {edu.advisor && <span> · Advisor: {edu.advisor}</span>}
            </div>
            {edu.dissertation && (
              <div class="timeline-details" style="font-style: italic;">
                Dissertation: “{edu.dissertation}”
              </div>
            )}
          </div>
        ))
      }
    </div>
  </section>

  <!-- 4. Selected Academic Service -->
  <section class="section-container">
    <div class="section-header">
      <h2 class="section-title">Selected Academic Service</h2>
    </div>

    <div class="timeline-list">
      {
        serviceCommittees.map((svc) => (
          <div class="timeline-item">
            <div class="timeline-header">
              <div style="font-size: 0.95rem; font-weight: 500;">
                {svc.link ? (
                  <a
                    href={svc.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="plain-link"
                    style="font-weight: 500;"
                  >
                    {svc.venue} ↗
                  </a>
                ) : (
                  <span>{svc.venue}</span>
                )}
                <span style="color: var(--text-muted); font-size: 0.88rem;"> — {svc.role}</span>
              </div>
              <span class="timeline-period">{svc.years}</span>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 5. Additional Details (Compact Disclosure Groups) -->
  <section class="section-container">
    <div class="section-header">
      <h2 class="section-title">Additional Details</h2>
    </div>

    <div class="about-disclosures">
      <!-- Research Interests & Ongoing Topics -->
      <details class="about-disclosure">
        <summary class="about-disclosure-summary">
          <span>Research Interests & Ongoing Topics</span>
          <span class="about-disclosure-chevron" aria-hidden="true">›</span>
        </summary>
        <div class="about-disclosure-content">
          <div class="timeline-list">
            {
              ongoingTopics.map((topic) => (
                <div class="timeline-item">
                  <div style="font-weight: 550; font-size: 0.95rem; margin-bottom: 0.15rem;">
                    {topic.title}
                  </div>
                  <div style="font-size: 0.88rem; color: var(--text-muted);">
                    {topic.collaboration}
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </details>

      <!-- Industry Projects & Patents -->
      <details class="about-disclosure">
        <summary class="about-disclosure-summary">
          <span>Industry Projects & Patents ({industryProjects.length})</span>
          <span class="about-disclosure-chevron" aria-hidden="true">›</span>
        </summary>
        <div class="about-disclosure-content">
          <div class="timeline-list">
            {
              industryProjects.map((proj) => (
                <div class="timeline-item">
                  <div class="timeline-header">
                    <div style="font-size: 0.95rem; font-weight: 550;">
                      {proj.title}
                      {proj.patentUrl && (
                        <a
                          href={proj.patentUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          style="margin-left: 0.4rem; font-size: 0.82rem; color: var(--accent); font-family: var(--font-mono);"
                        >
                          [US Patent ↗]
                        </a>
                      )}
                    </div>
                    <span class="timeline-period">{proj.period}</span>
                  </div>
                  <div class="timeline-org">{proj.organization}</div>
                </div>
              ))
            }
          </div>
        </div>
      </details>

      <!-- Journal Reviewing -->
      <details class="about-disclosure">
        <summary class="about-disclosure-summary">
          <span>Journal Reviewing</span>
          <span class="about-disclosure-chevron" aria-hidden="true">›</span>
        </summary>
        <div class="about-disclosure-content">
          <div style="margin-bottom: 0.85rem; font-size: 0.88rem;">
            <a
              href="https://www.webofscience.com/wos/author/record/45772582"
              target="_blank"
              rel="noopener noreferrer"
              class="plain-link"
              style="color: var(--accent); font-family: var(--font-mono); font-size: 0.84rem;"
            >
              Web of Science Profile ↗
            </a>
          </div>
          <div class="timeline-list">
            {
              journalReviews.map((review) => (
                <div class="timeline-item">
                  <div class="timeline-header">
                    <div style="font-size: 0.92rem;">{review.journal}</div>
                    <span class="timeline-period" style="color: var(--accent); font-weight: 600;">{review.count}</span>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </details>

      <!-- Funding & Scholarships -->
      <details class="about-disclosure">
        <summary class="about-disclosure-summary">
          <span>Funding & Scholarships ({fundings.length})</span>
          <span class="about-disclosure-chevron" aria-hidden="true">›</span>
        </summary>
        <div class="about-disclosure-content">
          <div class="timeline-list">
            {
              fundings.map((fund) => (
                <div class="timeline-item">
                  <div class="timeline-header">
                    <div style="font-size: 0.92rem; font-weight: 500;">{fund.title}</div>
                    <span class="timeline-period" style="color: var(--accent);">{fund.amount}</span>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </details>

      <!-- Collaborators -->
      <details class="about-disclosure">
        <summary class="about-disclosure-summary">
          <span>Collaborators ({collaborators.length})</span>
          <span class="about-disclosure-chevron" aria-hidden="true">›</span>
        </summary>
        <div class="about-disclosure-content">
          <div class="collaborators-wrap">
            {
              collaborators.map((c, i) => (
                <span class="collaborator-item">
                  {c.link ? (
                    <a
                      href={c.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="plain-link"
                      style="border-bottom: 1px dotted var(--border);"
                    >
                      {c.name}
                    </a>
                  ) : (
                    <span>{c.name}</span>
                  )}
                  {i < collaborators.length - 1 && (
                    <span class="collaborator-dot">·</span>
                  )}
                </span>
              ))
            }
          </div>
        </div>
      </details>

      <!-- Languages -->
      <details class="about-disclosure">
        <summary class="about-disclosure-summary">
          <span>Languages</span>
          <span class="about-disclosure-chevron" aria-hidden="true">›</span>
        </summary>
        <div class="about-disclosure-content">
          <div class="timeline-list">
            {
              languages.map((l) => (
                <div class="timeline-item">
                  <div class="timeline-header">
                    <div style="font-size: 0.92rem; font-weight: 500;">{l.language}</div>
                    <span class="timeline-period">{l.proficiency}</span>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </details>
    </div>
  </section>
</BaseLayout>
