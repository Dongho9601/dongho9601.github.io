---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('writing');
const posts = allPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => {
    const aTime = a.data.pubDate ? a.data.pubDate.valueOf() : 0;
    const bTime = b.data.pubDate ? b.data.pubDate.valueOf() : 0;
    return bTime - aTime;
  });
---

<BaseLayout
  title="Writing — Dongho Ha"
  description="Technical essays, reflections on computer architecture research, and guides by Dongho Ha."
>
  <header class="page-header">
    <h1 class="page-title">Writing</h1>
    <p class="page-lead">
      Articles, research notes, and reflections on computer architecture and graduate research.
    </p>
  </header>

  <section>
    <div class="card-grid">
      {
        posts.map((post) => (
          <Card
            title={post.data.title}
            description={post.data.description}
            href={post.data.externalUrl || `/writing/${post.id}`}
            isExternal={!!post.data.externalUrl}
            date={post.data.pubDate}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
