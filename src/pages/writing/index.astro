---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('writing');
const posts = allPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Writing — Dongho Ha"
  description="Technical essays, reflections on computer architecture research, and guides by Dongho Ha."
>
  <header style="margin-bottom: 3rem;">
    <h1 style="margin-bottom: 0.65rem;">Writing</h1>
    <p class="lead" style="color: var(--text-muted); margin-bottom: 0;">
      Articles, research notes, and reflections on computer architecture and graduate research.
    </p>
  </header>

  <section>
    <div class="post-list">
      {
        posts.map((post) => (
          <article class="post-item">
            <div class="post-title-row">
              <a href={`/writing/${post.id}`} class="post-title">
                {post.data.title}
              </a>
              <time class="post-date">
                {new Intl.DateTimeFormat('en-US', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                }).format(post.data.pubDate)}
              </time>
            </div>
            <p class="post-desc">{post.data.description}</p>
            {post.data.tags && post.data.tags.length > 0 && (
              <div
                style="display: flex; gap: 0.4rem; font-family: var(--font-mono); font-size: 0.78rem; color: var(--text-faint); margin-top: 0.2rem;"
              >
                {post.data.tags.map((tag) => (
                  <span>#{tag}</span>
                ))}
              </div>
            )}
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
