---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('writing');
const postsByArticle = new Map<string, (typeof allPosts)[number]>();

for (const post of allPosts.filter((entry) => !entry.data.draft)) {
  const key = post.data.translationKey ?? post.id;
  const current = postsByArticle.get(key);

  // The site navigation is in English, so use the English edition as the
  // writing-index entry when an article has multiple translations.
  if (!current || (post.data.language === 'en' && current.data.language !== 'en')) {
    postsByArticle.set(key, post);
  }
}

const posts = [...postsByArticle.values()]
  .sort((a, b) => {
    const aTime = a.data.pubDate ? a.data.pubDate.valueOf() : 0;
    const bTime = b.data.pubDate ? b.data.pubDate.valueOf() : 0;
    return bTime - aTime;
  });
---

<BaseLayout
  title="Writing — Dongho Ha"
  description="Technical essays, reflections on computer architecture research, and guides by Dongho Ha."
>
  <header class="page-header">
    <h1 class="page-title">Writing</h1>
    <p class="page-lead">
      Articles, research notes, and reflections on computer architecture and graduate research.
    </p>
  </header>

  <section>
    <div class="card-grid">
      {
        posts.map((post) => (
          <Card
            title={post.data.title}
            description={post.data.description}
            href={post.data.externalUrl || `/writing/${post.id}`}
            isExternal={!!post.data.externalUrl}
            date={post.data.pubDate}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
