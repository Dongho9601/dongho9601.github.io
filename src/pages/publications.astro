---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationItem from '../components/PublicationItem.astro';
import { publications, ongoingTopics } from '../data/publications';

// Group publications by year in descending order
const years = Array.from(new Set(publications.map((p) => p.year))).sort(
  (a, b) => b - a
);

const pubsByYear = years.map((year) => ({
  year,
  items: publications.filter((p) => p.year === year),
}));
---

<BaseLayout
  title="Publications — Dongho Ha"
  description="Peer-reviewed publications by Dongho Ha across computer architecture, GPU design, and hardware acceleration."
>
  <header style="margin-bottom: 3rem;">
    <h1 style="margin-bottom: 0.65rem;">Publications</h1>
    <p class="lead" style="color: var(--text-muted); margin-bottom: 0.5rem;">
      Research papers spanning GPU microarchitecture, memory subsystem optimization, numeric formats, and domain-specific accelerators.
    </p>
    <div style="font-family: var(--font-mono); font-size: 0.86rem; color: var(--text-faint);">
      Total: {publications.length} peer-reviewed publications · * denotes equal contribution / co-first authorship
    </div>
  </header>

  <section>
    {
      pubsByYear.map(({ year, items }) => (
        <div class="pub-year-group">
          <div class="pub-year-heading">{year}</div>
          <div class="pub-list">
            {items.map((pub) => (
              <PublicationItem pub={pub} showSummary={true} />
            ))}
          </div>
        </div>
      ))
    }
  </section>

  <!-- Ongoing Research Topics -->
  {ongoingTopics.length > 0 && (
    <section style="margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--border);">
      <h2 style="font-size: 1.25rem; margin-bottom: 1.25rem;">
        Ongoing Research Topics & Collaborations
      </h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem;">
        {ongoingTopics.map((topic) => (
          <div
            style="padding: 1rem 1.15rem; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-md);"
          >
            <div style="font-weight: 550; font-size: 0.95rem; margin-bottom: 0.25rem;">
              {topic.title}
            </div>
            <div style="font-size: 0.85rem; color: var(--text-muted); font-family: var(--font-mono);">
              {topic.collaboration}
            </div>
          </div>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
