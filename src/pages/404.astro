---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Page Not Found — Dongho Ha">
  <div style="padding: 4rem 0; text-align: center;">
    <div style="font-family: var(--font-mono); font-size: 2.5rem; color: var(--accent); margin-bottom: 1rem;">
      404
    </div>
    <h1 style="font-size: 1.8rem; margin-bottom: 1rem;">Page Not Found</h1>
    <p style="color: var(--text-muted); margin-bottom: 2rem;">
      The requested page could not be found.
    </p>
    <a
      href="/"
      class="plain-link"
      style="font-family: var(--font-mono); font-size: 0.9rem; color: var(--accent); border: 1px solid var(--border); padding: 0.5rem 1rem; border-radius: var(--radius-sm);"
    >
      ← Return to Homepage
    </a>
  </div>
</BaseLayout>
