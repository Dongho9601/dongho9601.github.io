---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationItem from '../components/PublicationItem.astro';
import Card from '../components/Card.astro';
import { siteConfig } from '../data/site';
import { publications } from '../data/publications';
import { getCollection } from 'astro:content';

const recentPublications = publications.slice(0, 5);

const writingPosts = await getCollection('writing');
const sortedPosts = writingPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => {
    const aTime = a.data.pubDate ? a.data.pubDate.valueOf() : 0;
    const bTime = b.data.pubDate ? b.data.pubDate.valueOf() : 0;
    return bTime - aTime;
  })
  .slice(0, 4);

const projects = await getCollection('projects');
const sortedProjects = projects.sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0)
);

// Primary hero links
const heroLinks = siteConfig.socials.filter((s) =>
  ['Google Scholar', 'GitHub', 'CV (PDF)'].includes(s.name)
);
---

<BaseLayout>
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-header">
      <h1 class="hero-title">{siteConfig.title}</h1>
      <div class="hero-subtitle">Computer Architect · Meta Infra Silicon</div>
    </div>

    <div class="hero-body">
      <div class="hero-content">
        <div class="hero-bio">
          <p class="lead">
            I am a Computer Architect and ASIC Engineer on the Infra Silicon team at{' '}
            <strong>Meta</strong>. I earned my M.S. & Ph.D. from <strong>Yonsei University</strong>{' '}
            (advised by Prof. Won Woo Ro), specializing in GPU microarchitecture, memory subsystem optimization,
            and computing resource efficiency for large-scale AI workloads.
          </p>
          <p class="hero-bio-secondary">
            My background includes system architecture research for SmartNIC DPUs at{' '}
            <strong>MangoBoost</strong>, visiting research at <strong>UC Riverside</strong>, and joint hardware development projects with Samsung and SK Hynix.
          </p>
        </div>

        <div class="hero-links">
          {
            heroLinks.map((link) => (
              <a
                href={link.url}
                class="hero-link"
                target={link.url.startsWith('http') ? '_blank' : undefined}
                rel={link.url.startsWith('http') ? 'noopener noreferrer' : undefined}
              >
                <span>{link.label}</span>
                <span class="hero-link-arrow" aria-hidden="true">↗</span>
              </a>
            ))
          }
        </div>
      </div>

      <div class="hero-avatar">
        <img
          src={siteConfig.avatar}
          alt={siteConfig.author}
          class="hero-avatar-img"
          width="160"
          height="160"
        />
      </div>
    </div>
  </section>

  <!-- 1. Experience Timeline -->
  <section class="section-container">
    <div class="section-header">
      <h2 class="section-title">Experience</h2>
      <a href="/about" class="section-action">
        Full background <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="experience-timeline">
      <div class="exp-timeline-list">
        <div class="exp-milestone is-current">
          <div class="exp-node" aria-hidden="true"></div>
          <div class="exp-content">
            <div class="exp-header">
              <h3 class="exp-role">ASIC Engineer</h3>
              <span class="exp-period">2025 — Present</span>
            </div>
            <div class="exp-org">Meta · Infra Silicon</div>
          </div>
        </div>

        <div class="exp-milestone">
          <div class="exp-node" aria-hidden="true"></div>
          <div class="exp-content">
            <div class="exp-header">
              <h3 class="exp-role">System Architect</h3>
              <span class="exp-period">2024 — 2025</span>
            </div>
            <div class="exp-org">MangoBoost</div>
          </div>
        </div>

        <div class="exp-milestone">
          <div class="exp-node" aria-hidden="true"></div>
          <div class="exp-content">
            <div class="exp-header">
              <h3 class="exp-role">M.S. & Ph.D.</h3>
              <span class="exp-period">2019 — 2024</span>
            </div>
            <div class="exp-org">Yonsei University</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Recent Publications -->
  <section class="section-container">
    <div class="section-header">
      <h2 class="section-title">Recent Publications</h2>
      <a href="/publications" class="section-action">
        View all ({publications.length}) <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="pub-list">
      {
        recentPublications.map((pub) => (
          <PublicationItem pub={pub} showSummary={false} />
        ))
      }
    </div>
  </section>

  <!-- 3. Writing -->
  <section class="section-container">
    <div class="section-header">
      <h2 class="section-title">Writing</h2>
      <a href="/writing" class="section-action">
        All writing <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="card-grid">
      {
        sortedPosts.map((post) => (
          <Card
            title={post.data.title}
            description={post.data.description}
            href={post.data.externalUrl || `/writing/${post.id}`}
            isExternal={!!post.data.externalUrl}
            date={post.data.pubDate}
          />
        ))
      }
    </div>
  </section>

  <!-- 4. Side Projects -->
  <section class="section-container">
    <div class="section-header">
      <h2 class="section-title">Side Projects</h2>
      <a href="/projects" class="section-action">
        All projects <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="card-grid">
      {
        sortedProjects.map((project) => (
          <Card
            title={project.data.title}
            description={project.data.description}
            href={`/projects/${project.id}`}
            status={project.data.status}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
