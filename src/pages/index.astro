---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationItem from '../components/PublicationItem.astro';
import { siteConfig } from '../data/site';
import { publications } from '../data/publications';
import { getCollection } from 'astro:content';

const recentPublications = publications.slice(0, 5);
const writingPosts = await getCollection('writing');
const sortedPosts = writingPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const projects = await getCollection('projects');
const sortedProjects = projects.sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0)
);
---

<BaseLayout>
  <!-- Hero Section -->
  <section class="hero">
    <h1 class="hero-title">{siteConfig.title}</h1>
    <div class="hero-subtitle">{siteConfig.subtitle} · Meta Infra Silicon</div>

    <div class="hero-bio">
      <p class="lead">
        I am a Computer Architect and ASIC Engineer on the Infra Silicon team at{' '}
        <strong>Meta</strong>. I earned my Ph.D. from <strong>Yonsei University</strong>{' '}
        (advised by Prof. Won Woo Ro), specializing in GPU microarchitecture, memory subsystem optimization,
        and computing resource efficiency for large-scale AI workloads.
      </p>
      <p style="color: var(--text-muted); font-size: 0.96rem; margin-bottom: 0;">
        My background includes system architecture research for SmartNIC DPUs at{' '}
        <strong>MangoBoost</strong>, visiting research at <strong>UC Riverside</strong>, and joint hardware development projects with Samsung and SK Hynix.
      </p>
    </div>

    <div class="hero-links">
      {
        siteConfig.socials.map((link) => (
          <a
            href={link.url}
            class="hero-link"
            target={link.url.startsWith('http') ? '_blank' : undefined}
            rel={link.url.startsWith('http') ? 'noopener noreferrer' : undefined}
          >
            <span>{link.name}</span>
            <span style="font-size: 0.8em; opacity: 0.7;">↗</span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Featured Projects -->
  <section style="margin-bottom: 3.5rem;">
    <div class="section-header">
      <h2 class="section-title">Selected Projects</h2>
      <a href="/projects" class="section-action">All projects →</a>
    </div>

    <div class="project-grid">
      {
        sortedProjects.map((project) => (
          <a href={`/projects/${project.id}`} class="project-card">
            <div class="project-header">
              <span class="project-name">{project.data.title}</span>
              <span class="project-status">{project.data.status}</span>
            </div>
            <p class="project-desc">{project.data.description}</p>
            {project.data.technologies.length > 0 && (
              <div class="project-tech-list">
                {project.data.technologies.map((tech) => (
                  <span class="project-tech-tag">{tech}</span>
                ))}
              </div>
            )}
          </a>
        ))
      }
    </div>
  </section>

  <!-- Recent Writing -->
  <section style="margin-bottom: 3.5rem;">
    <div class="section-header">
      <h2 class="section-title">Writing</h2>
      <a href="/writing" class="section-action">All writing →</a>
    </div>

    <div class="post-list">
      {
        sortedPosts.map((post) => (
          <article class="post-item">
            <div class="post-title-row">
              <a href={`/writing/${post.id}`} class="post-title">
                {post.data.title}
              </a>
              <time class="post-date">
                {new Intl.DateTimeFormat('en-US', {
                  year: 'numeric',
                  month: 'short',
                }).format(post.data.pubDate)}
              </time>
            </div>
            <p class="post-desc">{post.data.description}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Recent Publications -->
  <section>
    <div class="section-header">
      <h2 class="section-title">Recent Publications</h2>
      <a href="/publications" class="section-action">
        View all ({publications.length}) →
      </a>
    </div>

    <div class="pub-list">
      {
        recentPublications.map((pub) => (
          <PublicationItem pub={pub} showSummary={false} />
        ))
      }
    </div>

    <div style="margin-top: 1.5rem; text-align: right;">
      <a
        href="/publications"
        class="section-action"
        style="font-size: 0.9rem;"
      >
        Browse complete publication archive ({publications.length} papers) →
      </a>
    </div>
  </section>
</BaseLayout>
