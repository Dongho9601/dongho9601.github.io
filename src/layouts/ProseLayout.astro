---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  pubDate?: Date;
  tags?: string[];
  backHref: string;
  backLabel: string;
  externalUrl?: string;
  status?: string;
  technologies?: string[];
  heroImage?: string;
  githubUrl?: string;
  demoUrl?: string;
  playUrl?: string;
}

const {
  title,
  description,
  pubDate,
  tags = [],
  backHref,
  backLabel,
  externalUrl,
  status,
  technologies = [],
  heroImage,
  githubUrl,
  demoUrl,
  playUrl,
} = Astro.props;

const formattedDate = pubDate
  ? new Intl.DateTimeFormat('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    }).format(pubDate)
  : undefined;
---

<BaseLayout
  title={`${title} — Dongho Ha`}
  description={description}
  image={heroImage}
  articleDate={pubDate ? pubDate.toISOString() : undefined}
>
  <article>
    <div style="margin-bottom: 2rem;">
      <a
        href={backHref}
        class="plain-link"
        style="font-family: var(--font-mono); font-size: 0.86rem; color: var(--text-muted); display: inline-flex; align-items: center; gap: 0.35rem;"
      >
        ← {backLabel}
      </a>
    </div>

    <header style="margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--border-subtle);">
      <h1 style="margin-bottom: 0.65rem;">{title}</h1>
      <p class="lead" style="color: var(--text-muted); margin-bottom: 1rem;">
        {description}
      </p>

      <div
        style="display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.25rem; font-family: var(--font-mono); font-size: 0.84rem; color: var(--text-faint);"
      >
        {formattedDate && <span>{formattedDate}</span>}

        {status && (
          <span
            style="padding: 0.15rem 0.5rem; background: var(--bg-subtle); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); color: var(--text-muted);"
          >
            {status}
          </span>
        )}

        {technologies.length > 0 && (
          <span>Stack: {technologies.join(', ')}</span>
        )}

        {tags.length > 0 && (
          <div style="display: flex; gap: 0.5rem;">
            {tags.map((tag) => (
              <span>#{tag}</span>
            ))}
          </div>
        )}

        {externalUrl && (
          <a
            href={externalUrl}
            target="_blank"
            rel="noopener noreferrer"
            style="color: var(--accent); margin-left: auto;"
          >
            Open in Notion ↗
          </a>
        )}
      </div>

      {(githubUrl || demoUrl || playUrl) && (
        <div
          style="display: flex; flex-wrap: wrap; gap: 0.75rem 1.25rem; margin-top: 1rem; font-family: var(--font-mono); font-size: 0.84rem;"
        >
          {githubUrl && (
            <a
              href={githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="hero-link"
              style="color: var(--text-main);"
            >
              <span>GitHub</span>
              <span style="font-size: 0.8em; opacity: 0.7;">↗</span>
            </a>
          )}
          {demoUrl && (
            <a
              href={demoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="hero-link"
              style="color: var(--accent);"
            >
              <span>Live Demo</span>
              <span style="font-size: 0.8em; opacity: 0.7;">↗</span>
            </a>
          )}
          {playUrl && (
            <a
              href={playUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="hero-link"
              style="color: var(--accent);"
            >
              <span>Play</span>
              <span style="font-size: 0.8em; opacity: 0.7;">↗</span>
            </a>
          )}
        </div>
      )}
    </header>

    {heroImage && (
      <div style="margin-bottom: 2rem; border-radius: var(--radius-md); overflow: hidden; border: 1px solid var(--border);">
        <img
          src={heroImage}
          alt={title}
          style="width: 100%; height: auto; display: block; object-fit: cover;"
        />
      </div>
    )}

    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
