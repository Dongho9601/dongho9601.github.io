---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';

interface Props {
  title: string;
  description: string;
  pubDate?: Date;
  tags?: string[];
  backHref: string;
  backLabel: string;
  externalUrl?: string;
  status?: string;
  technologies?: string[];
  heroImage?: string;
  githubUrl?: string;
  demoUrl?: string;
  playUrl?: string;
  headings?: Array<{ depth: number; slug: string; text: string }>;
}

const {
  title,
  description,
  pubDate,
  tags = [],
  backHref,
  backLabel,
  externalUrl,
  status,
  technologies = [],
  heroImage,
  githubUrl,
  demoUrl,
  playUrl,
  headings = [],
} = Astro.props;

const formattedDate = pubDate
  ? new Intl.DateTimeFormat('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      timeZone: 'UTC',
    }).format(pubDate)
  : undefined;
---

<BaseLayout
  title={`${title} — Dongho Ha`}
  description={description}
  image={heroImage}
  articleDate={pubDate ? pubDate.toISOString() : undefined}
>
  <article class="prose-article">
    <div style="margin-bottom: 2rem;">
      <a
        href={backHref}
        class="plain-link"
        style="font-family: var(--font-mono); font-size: 0.84rem; color: var(--text-muted); display: inline-flex; align-items: center; gap: 0.35rem;"
      >
        ← {backLabel}
      </a>
    </div>

    <header style="margin-bottom: 2.25rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--border-subtle);">
      <h1 style="margin-bottom: 0.65rem;">{title}</h1>
      <p class="lead" style="color: var(--text-muted); margin-bottom: 1.25rem;">
        {description}
      </p>

      <div
        style="display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.25rem; font-family: var(--font-mono); font-size: 0.84rem; color: var(--text-faint);"
      >
        {formattedDate && <span>{formattedDate}</span>}

        {status && <span class="card-badge">{status}</span>}

        {technologies.length > 0 && (
          <div class="card-tags">
            {technologies.map((tech) => (
              <span class="card-tag">{tech}</span>
            ))}
          </div>
        )}

        {tags.length > 0 && (
          <div class="card-tags">
            {tags.map((tag) => (
              <span class="card-tag">#{tag}</span>
            ))}
          </div>
        )}

        {externalUrl && (
          <a
            href={externalUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="plain-link"
            style="color: var(--accent); margin-left: auto;"
          >
            Open in Notion ↗
          </a>
        )}
      </div>

      {(githubUrl || demoUrl || playUrl) && (
        <div
          style="display: flex; flex-wrap: wrap; gap: 0.85rem 1.35rem; margin-top: 1.25rem; font-family: var(--font-mono); font-size: 0.84rem;"
        >
          {githubUrl && (
            <a
              href={githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="hero-link"
            >
              <span>GitHub</span>
              <span class="hero-link-arrow">↗</span>
            </a>
          )}
          {demoUrl && (
            <a
              href={demoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="hero-link"
            >
              <span>Live Demo</span>
              <span class="hero-link-arrow">↗</span>
            </a>
          )}
          {playUrl && (
            <a
              href={playUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="hero-link"
            >
              <span>Play</span>
              <span class="hero-link-arrow">↗</span>
            </a>
          )}
        </div>
      )}
    </header>

    {heroImage && (
      <div style="margin-bottom: 2rem; border-radius: var(--radius-md); overflow: hidden; border: 1px solid var(--border);">
        <img
          src={heroImage}
          alt={title}
          style="width: 100%; height: auto; display: block; object-fit: cover;"
        />
      </div>
    )}

    {headings.length > 0 && <TableOfContents headings={headings} />}

    <div class="prose">
      <slot />
    </div>
  </article>

  <script>
    function setupHeadingAnchors() {
      const headings = document.querySelectorAll('.prose h2[id], .prose h3[id], .prose h4[id]');
      headings.forEach((heading) => {
        if (heading.querySelector('.heading-anchor')) return;
        const anchor = document.createElement('a');
        anchor.className = 'heading-anchor';
        anchor.href = '#' + heading.id;
        anchor.setAttribute('aria-label', `Direct link to section`);
        anchor.textContent = '#';
        heading.appendChild(anchor);
      });
    }

    setupHeadingAnchors();
    document.addEventListener('astro:after-swap', setupHeadingAnchors);
  </script>
</BaseLayout>
