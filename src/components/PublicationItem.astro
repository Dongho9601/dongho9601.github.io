---
import type { Publication } from '../data/publications';

interface Props {
  pub: Publication;
  showSummary?: boolean;
}

const { pub, showSummary = true } = Astro.props;

function isSelf(author: string): boolean {
  const clean = author.replace('*', '').trim().toLowerCase();
  return clean === 'dongho ha' || clean === 'dongho (lucas) ha';
}

function formatVenue(venue: string, venueShort?: string): string {
  const parenMatch = venue.match(/^(.+?)\s*\((.+?)\)$/);
  if (parenMatch) {
    const fullName = parenMatch[1].trim();
    const abbrev = parenMatch[2].trim();
    return `${fullName}, ${abbrev}`;
  }
  if (venueShort && !venue.includes(venueShort)) {
    return `${venue}, ${venueShort}`;
  }
  return venue;
}

const formattedVenue = formatVenue(pub.venue, pub.venueShort);
---

<article class="pub-item">
  <div class="pub-title-row">
    {
      pub.link && pub.link !== '#' ? (
        <a
          href={pub.link}
          target="_blank"
          rel="noopener noreferrer"
          class="pub-title"
        >
          {pub.title}
          <span class="pub-link-arrow" aria-hidden="true">↗</span>
        </a>
      ) : (
        <span class="pub-title">{pub.title}</span>
      )
    }
  </div>

  <div class="pub-citation">
    <span class="pub-authors">
      {
        pub.authors.map((author, index) => {
          const isMe = isSelf(author);
          const isLast = index === pub.authors.length - 1;
          const showAnd = pub.authors.length > 1 && isLast;
          return (
            <>
              {showAnd && <span>and </span>}
              {isMe ? (
                <strong class="pub-author-self">{author}</strong>
              ) : (
                <span>{author}</span>
              )}
              {!isLast && (pub.authors.length === 2 ? <span> </span> : <span>, </span>)}
            </>
          );
        })
      }
    </span>{' '}
    <span class="pub-venue">({formattedVenue}).</span>
    {pub.highlight && (
      <span class="pub-award"> · {pub.highlight}</span>
    )}
  </div>

  {showSummary && pub.summary && (
    <p class="pub-summary">{pub.summary}</p>
  )}
</article>
