---
import type { Publication } from '../data/publications';

interface Props {
  pub: Publication;
  showSummary?: boolean;
}

const { pub, showSummary = true } = Astro.props;

function isSelf(author: string): boolean {
  const clean = author.replace('*', '').trim().toLowerCase();
  return clean === 'dongho ha' || clean === 'dongho (lucas) ha';
}
---

<article class="pub-item">
  <div class="pub-title-row">
    {
      pub.link && pub.link !== '#' ? (
        <a
          href={pub.link}
          target="_blank"
          rel="noopener noreferrer"
          class="pub-title"
        >
          {pub.title}
          <span style="display: inline-block; margin-left: 0.25rem; font-size: 0.85em; opacity: 0.7;">↗</span>
        </a>
      ) : (
        <span class="pub-title">{pub.title}</span>
      )
    }
  </div>

  <div class="pub-authors">
    {
      pub.authors.map((author, index) => {
        const isMe = isSelf(author);
        const isLast = index === pub.authors.length - 1;
        return (
          <>
            {isMe ? (
              <strong class="pub-author-self">{author}</strong>
            ) : (
              <span>{author}</span>
            )}
            {!isLast && <span>, </span>}
          </>
        );
      })
    }
  </div>

  <div class="pub-venue-row">
    <span class="pub-venue-badge">{pub.venue}</span>
    {pub.highlight && (
      <>
        <span>·</span>
        <span class="pub-award">{pub.highlight}</span>
      </>
    )}
  </div>

  {showSummary && pub.summary && (
    <p class="pub-summary">{pub.summary}</p>
  )}
</article>
